---
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/blocks/layout/Container.astro';
import Headline from '~/components/blocks/primitives/Headline.astro';
import TwoColumnContainer from '~/components/blocks/layout/TwoColumnContainer.astro';
import Image from '~/components/blocks/primitives/Image.astro';
import ContentCarousel from '~/components/blocks/composite/ContentCarousel.astro';
import ContentCarouselItem from '~/components/blocks/primitives/ContentCarouselItem.astro';
import Video from '~/components/blocks/primitives/Video.astro';
import Content from '~/components/blocks/composite/Content.astro';
import ItemsTimeline from '~/components/blocks/composite/ItemsTimeline.astro';
import CallToAction from '~/components/blocks/composite/CallToAction.astro';
---

<Layout langCode="en">
  <!-- Hero Section -->
  <Container
    minHeight="h-screen"
    background={{
      video: '/videos/index-hero.mp4',
    }}
    content={{
      widthType: 'full',
    }}
  >
    <Headline
      class="text-mantle absolute left-1/2 top-3/4 md:left-3/4 md:top-1/2 -translate-x-1/2 -translate-y-1/2"
      htmlTag="h1"
      title="Calavera"
    />
  </Container>

  <!-- Blockquote Section -->
  <Container>
    <blockquote class="text-center">
      When death meets color, <br />
      memory becomes light, <br />
      and life, a celebration...
    </blockquote>
  </Container>

  <!-- La Calavera Section -->
  <Container background={{ class: 'bg-surface' }}>
    <Headline anchorId="la-calavera" title="La Calavera" />
    <p class="text-center">
      Inspired by the Mexican Día de Muertos, <strong
        >Calavera celebrates life, memory and color.</strong
      ><br />
      Black titanium, gold, sapphires and colored lacquers meet in a play of contrasts.
    </p>

    <div class="w-screen relative left-1/2 -translate-x-1/2 overflow-x-clip">
      <ContentCarousel loop autoplay={{ enabled: true, delay: 3000, pauseOnHover: true }}>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/calavera/01.jpg"
            alt="Calavera ring in black titanium with coral lacquer and green sapphires set in gold"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/calavera/02.jpg"
            alt="Calavera ring in black titanium with turquoise lacquer and orange sapphires set in gold"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/calavera/03.jpg"
            alt="Calavera ring in black titanium with yellow lacquer and blue sapphires set in gold"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
      </ContentCarousel>
    </div>

    <TwoColumnContainer
      htmlTag="div"
      responsive
      content={{
        air: 'none',
      }}
      spacing={{ margin: 'mt-12 md:mt-16 lg:mt-20' }}
    >
      <div slot="left" class="h-full flex flex-col justify-center">
        <p>In Mexico, death is part of life, of our memories and of our identity.</p>
        <p><strong>Memory unites us.</strong></p>
        <p><strong>Color moves us.</strong></p>
        <p><strong>Life is celebrated.</strong></p>
        <p>
          Calavera draws its inspiration from this Mexican tradition, where colors and symbols
          transform remembrance into celebration.
        </p>
        <p>
          Each creation combines <strong
            >black titanium, gold, sapphires and colored lacquers.</strong
          >
        </p>
        <p>Memories remain, life keeps reinventing itself.</p>
      </div>
      <div slot="right">
        <Video
          aspectRatio="square"
          autoplay
          loop
          muted
          hideControls
          source={{
            type: 'video',
            sources: [
              {
                src: '/videos/calavera/calavera.mp4',
                type: 'video/mp4',
                size: 914,
              },
            ],
          }}
        />
      </div>
    </TwoColumnContainer>
  </Container>

  <!-- Vision Section -->
  <Content
    headline={{ anchorId: 'vision', title: 'Vision' }}
    imagePosition="left"
    image={{
      src: '~/assets/images/vision/vision.jpg',
      alt: 'Obsidian pendant',
      layout: 'responsive',
      class: 'rounded-lg shadow',
    }}
    slotClass="h-full flex flex-col justify-center"
  >
    <p>
      <strong>Restoring jewelry's human and living dimension.</strong>
    </p>
    <p>
      For over twenty years, technology has been an integral part of my passion for fine jewellery.
      I see it as a way to push the boundaries of creativity.
    </p>
    <p>
      3D modelling, engineering and innovative manufacturing techniques allow me to explore new
      forms, movements and materials, while preserving what matters most: the emotion and intention
      behind each piece.
    </p>
    <p>
      Born in Mexico, educated in Italy and shaped by my experience within prestigious Parisian
      jewellery houses, I draw inspiration from these three worlds to create fine jewellery that is
      free-spirited, bold and contemporary.
    </p>
  </Content>

  <!-- The Creator Section -->
  <Content
    container={{ background: { class: 'bg-surface' } }}
    headline={{
      title: 'The Creator',
      anchorId: 'creator',
    }}
    image={{
      src: '~/assets/images/me-smoreno.jpeg',
      alt: 'Sofia Moreno',
      layout: 'responsive',
      class: 'rounded-lg shadow',
    }}
    slotClass="h-full flex flex-col justify-center"
  >
    <p>She was born in Mexico. A country of intense colors, powerful symbols, resilience.</p>
    <p>
      In Italy, she studies jewelry engineering.<br />
      There she learns 3D modeling, rigor, precision, the demand for detail.
    </p>
    <p>
      In Paris, within prestigious houses, she participates in the development of iconic
      collections.
    </p>
    <p>Today, she connects these three worlds, and pursues her dreams to the fullest.</p>
  </Content>

  <!-- The Succulents Section -->
  <Container>
    <Headline anchorId="the-succulents" title="The Succulents" />
    <div class="text-center">
      <p>
        Inspired by the succulent plants of Mexico, this collection celebrates <strong
          >resilience</strong
        >, <strong>femininity</strong> and <strong>transformation</strong>. Organic, sculptural
        forms that evoke the strength of nature and the beauty of movement.
      </p>
      <p>
        <strong>Colored titanium</strong> meets gold and diamonds in a play of materials, light and contrasts.
        Contemporary, bold jewelry full of life, where every detail reveals a new facet.
      </p>
      <p>
        Designed to be <strong>modular</strong> and <strong>customizable</strong>, the collection
        offers many configuration possibilities. Colors, volumes and compositions are reinvented at
        will, to create a one-of-a-kind piece.
      </p>
      <p>
        <strong>A living collection</strong>, inspired by nature, that celebrates the freedom to be
        yourself and to reinvent yourself.
      </p>
    </div>

    <div class="w-screen relative left-1/2 -translate-x-1/2 overflow-x-clip">
      <ContentCarousel loop autoplay={{ enabled: true, delay: 3000, pauseOnHover: true }}>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/succulentes/01.jpg"
            alt="Succulent pendant in pink titanium, gold and diamonds"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/succulentes/02.jpg"
            alt="Succulent necklace in green titanium, gold and diamonds"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/succulentes/03.jpg"
            alt="Succulent earring in blue-green titanium, gold and diamonds, worn"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/succulentes/04.jpg"
            alt="Succulent necklace in purple titanium, gold and diamonds"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/succulentes/05.jpg"
            alt="Succulent necklace in green titanium and gold on a double gold cord"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
      </ContentCarousel>
    </div>
  </Container>

  <!-- Bespoke Jewelry Section -->
  <Container background={{ class: 'bg-surface' }}>
    <Headline anchorId="bespoke-jewelry" title="Bespoke Jewelry" class="mb-6 md:mb-8 lg:mb-12" />
    <TwoColumnContainer htmlTag="div" responsive content={{ air: 'none' }}>
      <div slot="left" class="h-full flex flex-col justify-center">
        <ItemsTimeline
          defaultItemConfig={{
            icon: { class: 'bg-tertiary text-background p-2 rounded-full' },
          }}
          items={[
            {
              icon: { name: 'tabler:bulb' },
              title: 'Intention',
              content: 'We define your story, your symbols, your moment.',
            },
            {
              icon: { name: 'tabler:brush' },
              title: 'Visualization',
              content: 'We design the piece with you.',
            },
            {
              icon: { name: 'tabler:mouse' },
              title: 'Transformation',
              content:
                'We adjust and transform the design in 3D. Volumes, proportions and details are refined until the perfect balance.',
            },
            {
              icon: { name: 'tabler:diamond' },
              title: 'Fabrication',
              content: 'The piece is crafted in precious metals.',
            },
          ]}
        />
      </div>
      <div slot="right">
        <ContentCarousel loop autoplay={{ enabled: true, delay: 3000, pauseOnHover: true }}>
          <ContentCarouselItem basis="basis-full">
            <Image
              src="~/assets/images/sur mesure/01.jpg"
              alt="Sofia Moreno from behind at her jeweller's bench, among tools, a succulent and marigolds"
              layout="responsive"
              class="rounded-lg shadow"
            />
          </ContentCarouselItem>
          <ContentCarouselItem basis="basis-full">
            <Image
              src="~/assets/images/sur mesure/02.jpg"
              alt="Sofia Moreno modelling a calavera in 3D on a computer"
              layout="responsive"
              class="rounded-lg shadow"
            />
          </ContentCarouselItem>
        </ContentCarousel>
      </div>
    </TwoColumnContainer>
  </Container>

  <!-- Call to Action Section -->
  <CallToAction
    headline={{
      anchorId: 'contact-me',
      title: 'Contact Me',
      subtitle:
        'Fill out the form to discuss your bespoke jewelry project, or for any questions about the collections.',
    }}
    actions={[
      {
        label: 'Fill out the form',
        icon: { name: 'tabler:category' },
        intent: 'primary',
        size: 'lg',
        variant: 'solid',
        shape: 'pill',
        href: 'https://beautiful-radar-d8c.notion.site/237e05212921801cb353e2886bb57c89?pvs=105',
        target: '_blank',
      },
      {
        label: 'Contact me',
        icon: { name: 'tabler:mail' },
        intent: 'secondary',
        size: 'lg',
        variant: 'solid',
        shape: 'pill',
        href: 'mailto:contact@sofiamoreno.fr',
      },
    ]}
  />
</Layout>
