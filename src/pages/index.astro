---
import Layout from '~/layouts/Layout.astro';
import Container from '~/components/blocks/layout/Container.astro';
import Headline from '~/components/blocks/primitives/Headline.astro';
import TwoColumnContainer from '~/components/blocks/layout/TwoColumnContainer.astro';
import Image from '~/components/blocks/primitives/Image.astro';
import ContentCarousel from '~/components/blocks/composite/ContentCarousel.astro';
import ContentCarouselItem from '~/components/blocks/primitives/ContentCarouselItem.astro';
import Video from '~/components/blocks/primitives/Video.astro';
import Content from '~/components/blocks/composite/Content.astro';
import ItemsTimeline from '~/components/blocks/composite/ItemsTimeline.astro';
import CallToAction from '~/components/blocks/composite/CallToAction.astro';
---

<Layout>
  <!-- Hero Section -->
  <Container
    minHeight="h-screen"
    background={{
      video: '/videos/index-hero.mp4',
    }}
    content={{
      widthType: 'full',
    }}
  >
    <Headline
      class="text-mantle absolute left-1/2 top-3/4 md:left-3/4 md:top-1/2 -translate-x-1/2 -translate-y-1/2"
      htmlTag="h1"
      title="Calavera"
    />
  </Container>

  <!-- Blockquote Section -->
  <Container>
    <blockquote class="text-center">
      Quand la mort rencontre la couleur, <br />
      le souvenir devient lumière, <br />
      et la vie, une célébration...
    </blockquote>
  </Container>

  <!-- La Calavera Section -->
  <Container background={{ class: 'bg-surface' }}>
    <Headline anchorId="la-calavera" title="La Calavera" />
    <p class="text-center">
      Inspirée du Día de Muertos mexicain, <strong
        >Calavera célèbre la vie, la mémoire et la couleur.</strong
      ><br /> Le titane noir, l'or, les saphirs et les laques colorées se rencontrent dans un jeu de contrastes.
    </p>

    <div class="w-screen relative left-1/2 -translate-x-1/2 overflow-x-clip">
      <ContentCarousel loop autoplay={{ enabled: true, delay: 3000, pauseOnHover: true }}>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/calavera/01.jpg"
            alt="Bague Calavera en titane noir, laque corail et saphirs verts sertis d'or"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/calavera/02.jpg"
            alt="Bague Calavera en titane noir, laque turquoise et saphirs orange sertis d'or"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/calavera/03.jpg"
            alt="Bague Calavera en titane noir, laque jaune et saphirs bleus sertis d'or"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
      </ContentCarousel>
    </div>

    <TwoColumnContainer
      htmlTag="div"
      responsive
      content={{
        air: 'none',
      }}
      spacing={{ margin: 'mt-12 md:mt-16 lg:mt-20' }}
    >
      <div slot="left" class="h-full flex flex-col justify-center">
        <p>Au Mexique, la mort fait partie de la vie, de nos souvenirs et de notre identité.</p>
        <p><strong>La mémoire nous unit.</strong></p>
        <p><strong>La couleur nous anime.</strong></p>
        <p><strong>La vie se célèbre.</strong></p>
        <p>
          Calavera puise son inspiration dans cette tradition mexicaine, où les couleurs et les
          symboles transforment le souvenir en célébration.
        </p>
        <p>Chaque création associe <strong>titane noir, or, saphirs et laques colorées.</strong></p>
        <p>Les souvenirs restent, la vie continue de se réinventer.</p>
      </div>
      <div slot="right">
        <Video
          aspectRatio="square"
          autoplay
          loop
          muted
          hideControls
          source={{
            type: 'video',
            sources: [
              {
                src: '/videos/calavera/calavera.mp4',
                type: 'video/mp4',
                size: 914,
              },
            ],
          }}
        />
      </div>
    </TwoColumnContainer>
  </Container>

  <!-- Vision Section -->
  <Content
    headline={{ anchorId: 'vision', title: 'Vision' }}
    imagePosition="left"
    image={{
      src: '~/assets/images/vision/vision.jpg',
      alt: 'Pendentif obsidienne',
      layout: 'responsive',
      class: 'rounded-lg shadow',
    }}
    slotClass="h-full flex flex-col justify-center"
  >
    <p>
      <strong>Redonner à la joaillerie sa dimension humaine et vivante.</strong>
    </p>
    <p>
      Depuis plus de vingt ans, la technologie accompagne ma passion pour la joaillerie. Je la vois
      comme un moyen de repousser les limites de la création.
    </p>
    <p>
      La modélisation 3D, l'ingénierie et les nouvelles techniques de fabrication me permettent
      d'explorer des formes, des mouvements et des matières, tout en préservant l'essentiel :
      l'émotion et l'intention derrière chaque pièce.
    </p>
    <p>
      Née au Mexique, formée en Italie et enrichie par mon parcours au sein des grandes maisons
      parisiennes, je puise dans ces trois univers pour imaginer une joaillerie libre, audacieuse et
      contemporaine.
    </p>
  </Content>

  <!-- La Créatrice Section -->
  <Content
    container={{ background: { class: 'bg-surface' } }}
    headline={{
      title: 'La Créatrice',
      anchorId: 'creatrice',
    }}
    image={{
      src: '~/assets/images/me-smoreno.jpeg',
      alt: 'Sofia Moreno',
      layout: 'responsive',
      class: 'rounded-lg shadow',
    }}
    slotClass="h-full flex flex-col justify-center"
  >
    <p>
      Elle est née au Mexique. Un pays de couleurs intenses, de symboles puissants, de résilience.
    </p>
    <p>
      En Italie, elle étudie l'ingénierie joaillière.<br />
      Elle y apprend la modélisation 3D, la rigueur, la précision, l'exigence du détail..
    </p>
    <p>
      À Paris, au sein de grandes maisons, elle participe au développement de collections
      emblématiques.
    </p>
    <p>Aujourd'hui, elle relie ces trois mondes, et elle y va au bout de ses rêves.</p>
  </Content>

  <!-- Les Succulentes -->
  <Container>
    <Headline anchorId="les-succulentes" title="Les Succulentes" />
    <div class="text-center">
      <p>
        Inspirée des plantes succulentes du Mexique, cette collection célèbre la <strong
          >résilience</strong
        >, la <strong>féminité</strong> et la <strong>transformation</strong>. Des formes organiques
        et sculpturales qui évoquent la force de la nature et la beauté du mouvement.
      </p>
      <p>
        Le <strong>titane coloré</strong> rencontre l'or et les diamants dans un jeu de matières, de lumière
        et de contrastes. Une joaillerie contemporaine, audacieuse et pleine de vie, où chaque détail
        révèle une nouvelle facette.
      </p>
      <p>
        Pensée pour être <strong>modulable</strong> et <strong>personnalisable</strong>, la
        collection offre de nombreuses possibilités de configuration. Couleurs, volumes et
        compositions se réinventent au gré des envies, pour créer une pièce singulière.
      </p>
      <p>
        <strong>Une collection vivante</strong>, inspirée par la nature, qui célèbre la liberté
        d'être soi et de se réinventer.
      </p>
    </div>

    <div class="w-screen relative left-1/2 -translate-x-1/2 overflow-x-clip">
      <ContentCarousel loop autoplay={{ enabled: true, delay: 3000, pauseOnHover: true }}>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/succulentes/01.jpg"
            alt="Pendentif succulente en titane rose, or et diamants"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/succulentes/02.jpg"
            alt="Collier succulente en titane vert, or et diamants"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/succulentes/03.jpg"
            alt="Boucle d'oreille succulente en titane bleu-vert, or et diamants portée"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/succulentes/04.jpg"
            alt="Collier succulente en titane violet, or et diamants"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
        <ContentCarouselItem
          content={{ air: 'tight' }}
          basis="basis-full md:basis-1/2 lg:basis-1/3"
        >
          <Image
            src="~/assets/images/succulentes/05.jpg"
            alt="Collier succulente en titane vert et or sur double cordon doré"
            layout="responsive"
            class="rounded-lg border border-elevated shadow"
          />
        </ContentCarouselItem>
      </ContentCarousel>
    </div>
  </Container>

  <!-- Joaillerie sur mesure Section -->
  <Container background={{ class: 'bg-surface' }}>
    <Headline
      anchorId="joaillerie-sur-mesure"
      title="Joaillerie sur mesure"
      class="mb-6 md:mb-8 lg:mb-12"
    />
    <TwoColumnContainer htmlTag="div" responsive content={{ air: 'none' }}>
      <div slot="left" class="h-full flex flex-col justify-center">
        <ItemsTimeline
          defaultItemConfig={{
            icon: { class: 'bg-tertiary text-background p-2 rounded-full' },
          }}
          items={[
            {
              icon: { name: 'tabler:bulb' },
              title: 'Intention',
              content: 'Nous définissons votre histoire, vos symboles, votre moment.',
            },
            {
              icon: { name: 'tabler:brush' },
              title: 'Visualisation',
              content: 'Nous dessinons la pièce avec vous.',
            },
            {
              icon: { name: 'tabler:mouse' },
              title: 'Transformation',
              content:
                "Nous ajustons et transformons le design en 3D. Les volumes, les proportions et les détails sont affinés jusqu'à l'équilibre parfait.",
            },
            {
              icon: { name: 'tabler:diamond' },
              title: 'Fabrication',
              content: 'La pièce est réalisée  en métaux précieux.',
            },
          ]}
        />
      </div>
      <div slot="right">
        <ContentCarousel loop autoplay={{ enabled: true, delay: 3000, pauseOnHover: true }}>
          <ContentCarouselItem basis="basis-full">
            <Image
              src="~/assets/images/sur mesure/01.jpg"
              alt="Sofia Moreno de dos à son établi de joaillerie, entre outils, succulente et fleurs de cempasúchil"
              layout="responsive"
              class="rounded-lg shadow"
            />
          </ContentCarouselItem>
          <ContentCarouselItem basis="basis-full">
            <Image
              src="~/assets/images/sur mesure/02.jpg"
              alt="Sofia Moreno modélisant en 3D une calavera sur ordinateur"
              layout="responsive"
              class="rounded-lg shadow"
            />
          </ContentCarouselItem>
        </ContentCarousel>
      </div>
    </TwoColumnContainer>
  </Container>

  <!-- Call to Action Section -->
  <CallToAction
    headline={{
      anchorId: 'contactez-moi',
      title: 'Contactez-moi',
      subtitle:
        'Remplissez le formulaire pour discuter de votre projet de bijou sur mesure, ou pour toute question sur les collections.',
    }}
    actions={[
      {
        label: 'Remplissez le formulaire',
        icon: { name: 'tabler:category' },
        intent: 'primary',
        size: 'lg',
        variant: 'solid',
        shape: 'pill',
        href: 'https://beautiful-radar-d8c.notion.site/237e05212921801cb353e2886bb57c89?pvs=105',
        target: '_blank',
      },
      {
        label: 'Contactez-moi',
        icon: { name: 'tabler:mail' },
        intent: 'secondary',
        size: 'lg',
        variant: 'solid',
        shape: 'pill',
        href: 'mailto:contact@sofiamoreno.fr',
      },
    ]}
  />
</Layout>
